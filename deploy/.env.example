# Production environment for docker-compose.prod.yml.
# Copy to deploy/.env and fill in real values. NEVER commit deploy/.env.
#
#   cp deploy/.env.example deploy/.env
#   openssl rand -hex 48   # -> JWT_SECRET
#   openssl rand -hex 32   # -> TELEGRAM_TOKEN_KEY

# ----- Domain / public URL (required for HTTPS and the Telegram webhook) -----
# The domain's A-record must point to this server before the first start (Let's Encrypt).
DOMAIN=chat.example.com
PUBLIC_BASE_URL=https://chat.example.com

# ----- Panels domain (optional, but required for the landing/panels split) -----
# Панели выносятся на отдельный домен; лендинг остаётся на DOMAIN.
# Its A-record must also point to this server (Caddy issues a separate cert).
# Leave empty to keep everything on DOMAIN (legacy single-domain behaviour).
APP_DOMAIN=app.chat.example.com

# ----- Postgres (internal only, not published) -----
POSTGRES_USER=support_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=support_chat

# ----- Backend secrets -----
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
TELEGRAM_TOKEN_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=12h
CHAT_TIMEOUT_MINUTES=7

# SEC-08: general API requests allowed per IP per 15-min window (default 1000).
# Raise it if a busy operator/office IP hits "Слишком много запросов".
API_RATE_LIMIT_MAX=1000

# Sites allowed to embed the widget (comma-separated). Include your own domains.
CORS_ORIGINS=https://chat.example.com,https://app.chat.example.com

# ----- First-run seed (superadmin + default tenant) -----
# Set RUN_SEED=true for the very first boot, then you can leave it (seed is idempotent).
RUN_SEED=true
ADMIN_EMAIL=owner@example.com
# SEC-04: only needed for the FIRST seed. After the superadmin exists, remove this
# line from deploy/.env (and keep the password in a password manager).
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_NAME=Владелец
TENANT_SLUG=default
TENANT_NAME=Главный офис
# Leave empty in production so re-seeding does not reset a tenant admin's password.
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# ----- Billing / payments (CryptoBot) -----
# Crypto Pay API token from @CryptoBot -> "Crypto Pay" -> Create App -> API token.
# Leave EMPTY to disable online payment (the owner then confirms payments in the CRM).
CRYPTOBOT_TOKEN=
# Fiat USD invoices are the default. Set CRYPTOBOT_CURRENCY_TYPE=crypto to invoice
# in a crypto asset instead (CRYPTOBOT_ASSET, default USDT).
CRYPTOBOT_CURRENCY_TYPE=fiat
CRYPTOBOT_FIAT=USD
CRYPTOBOT_ASSET=USDT

# ----- Backups (SEC-10) -----
# deploy/backup.sh encrypts the dump + uploads with GPG (AES256). Create the
# passphrase file ONCE (mode 600) and keep a copy OFF the server:
#   openssl rand -base64 32 > /root/.backup-passphrase && chmod 600 /root/.backup-passphrase
BACKUP_PASSPHRASE_FILE=/root/.backup-passphrase
# Optional: push encrypted backups to another host over SSH (rsync).
# Leave empty to keep backups on this server only (not recommended).
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PATH=

# ----- Monitoring & alerts -----
# Protects GET /status (uptime/DB/disk/memory/Telegram details). Leave empty to
# disable the endpoint. Generate with:  openssl rand -hex 32
STATUS_TOKEN=
# Warning thresholds (percent) used by GET /status.
MONITOR_DISK_WARN=85
MONITOR_MEM_WARN=90

# Owner-only alert bot (separate from tenant bots). Read by deploy/monitor.sh on
# the HOST — these are deliberately NOT passed into the app container.
#   token: BotFather -> /newbot (or /token)
ALERT_TELEGRAM_TOKEN=
# Where the alerts go. Write the bot once from the owner's account, then read the
# id:  curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
# (private chat → positive id, group → negative id).
ALERT_TELEGRAM_CHAT_ID=
# Repeat-notification cooldown for a still-failing check, in seconds (default 900).
MONITOR_COOLDOWN_SECONDS=900
# TLS certificate warning threshold, in days.
MONITOR_TLS_WARN_DAYS=14
