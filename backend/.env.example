# backend — переменные окружения (имена без значений)
# Скопируйте в backend/.env и заполните реальными значениями. .env не коммитится.

# --- Сервер ---
NODE_ENV=development
PORT=3000

# --- База данных (Postgres) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=support_user
DB_PASSWORD=
DB_NAME=support_chat

# --- Авторизация ---
# ОБЯЗАТЕЛЬНО: длинная случайная строка. Без неё сервер не стартует.
JWT_SECRET=
# Время жизни токена (например, 12h).
JWT_EXPIRES_IN=12h

# --- CORS ---
# Список origin через запятую. В production при пустом значении — только same-origin.
CORS_ORIGINS=

# --- Чаты ---
# Fallback таймаута авто-закрытия (мин) для тенантов без значения в settings.
CHAT_TIMEOUT_MINUTES=7

# --- Seed (первичное наполнение) ---
# Платформенный суперадмин (вне тенанта).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Демо-тенант (удобство для dev).
TENANT_SLUG=default
TENANT_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# --- Telegram-бот (раздел 9, опционально) ---
# AES-256-GCM ключ для шифрования токенов ботов. Если не задан — используется JWT_SECRET.
TELEGRAM_TOKEN_KEY=
# Публичный HTTPS-origin платформы, напр. https://chat.example.com.
# Webhook бота регистрируется на ${PUBLIC_BASE_URL}/api/tg/:botId. Если пусто — webhook не регистрируется.
PUBLIC_BASE_URL=
# Переопределение базового URL Bot API (тесты/моки). По умолчанию https://api.telegram.org
TELEGRAM_API_BASE=
