# Copy to .env and set real values. Never commit .env.
# Postgres (used by docker-compose.yml)
POSTGRES_USER=support_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_chat
POSTGRES_PORT=5433

# Backend (see backend/.env)
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME — same values as above
# JWT_SECRET — REQUIRED, random string
# ADMIN_EMAIL / ADMIN_PASSWORD — platform superadmin (no tenant)
# TENANT_ADMIN_EMAIL / TENANT_ADMIN_PASSWORD — demo tenant admin (dev convenience)
# TENANT_SLUG / TENANT_NAME — default tenant created at seed
# CHAT_TIMEOUT_MINUTES — fallback for tenants without a settings value
#
# Telegram (section 9, optional — only needed to enable the Telegram bot integration)
# TELEGRAM_TOKEN_KEY — AES-256-GCM key for encrypting stored bot tokens.
#                      If unset, JWT_SECRET is used as the key material.
# PUBLIC_BASE_URL    — public HTTPS origin of the platform, e.g. https://chat.example.com.
#                      Webhook for a bot is registered at ${PUBLIC_BASE_URL}/api/tg/:botId.
#                      If empty, the webhook is not registered automatically.
# TELEGRAM_API_BASE  — override the Bot API base URL (tests/mocks only). Default https://api.telegram.org