# Copy to .env and set real values. Never commit .env.
# Postgres (used by docker-compose.yml)
POSTGRES_USER=support_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_chat
POSTGRES_PORT=5433

# Backend (see backend/.env)
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME — same values as above
# JWT_SECRET — REQUIRED, random string
# ADMIN_EMAIL / ADMIN_PASSWORD — platform superadmin (no tenant)
# TENANT_ADMIN_EMAIL / TENANT_ADMIN_PASSWORD — demo tenant admin (dev convenience)
# TENANT_SLUG / TENANT_NAME — default tenant created at seed
# CHAT_TIMEOUT_MINUTES — fallback for tenants without a settings value